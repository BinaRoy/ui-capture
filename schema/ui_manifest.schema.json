{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ui_manifest",
  "description": "Output of the ui-capture skill. Consumed by /architecture-gen and Worker/Reviewer agents.",
  "type": "object",
  "required": ["schema_version", "adapter", "status", "pages"],
  "properties": {
    "schema_version": {"const": 1},
    "adapter": {"type": "string", "description": "workflow.config.json adapter.name"},
    "platform": {
      "type": ["string", "null"],
      "enum": ["android", "ios", "harmony", "cangjie", "manual", null],
      "description": "Adapter/platform that produced this manifest. Android, iOS, and Harmony are first-class source capture platforms; cangjie/manual are accepted for derived or degraded artifacts."
    },
    "mode": {"type": "string", "enum": ["pipeline", "standalone"]},
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "infrastructure_missing",
        "scaffold_pending",
        "adapter_unsupported",
        "all_pages_failed",
        "partial",
        "nav_script_error",
        "no_pages_requested",
        "timed_out"
      ],
      "description": "Overall run status. arch-gen should treat anything except 'ok' as degraded input."
    },
    "stub_reason": {"type": "string"},
    "config": {"type": "string"},
    "source_root": {"type": "string"},
    "feature_json": {"type": "string"},
    "phases": {
      "type": "object",
      "additionalProperties": {"type": "object"}
    },
    "pages": {
      "type": "array",
      "items": {"$ref": "#/$defs/page"}
    },
    "shell_features": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Features that exist in feature.json but have no captured UI surface. arch-gen should treat these as routing / glue only."
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable page id. Conventions: '<feature>' for single main page; '<feature>/<slug>' for multiple main pages; '<feature>#<slug>' for a sub-card embedded in a parent page."
        },
        "status": {
          "type": "string",
          "enum": [
            "captured",
            "failed",
            "skipped",
            "identity_mismatch",
            "captured_manual",
            "manual_unbound",
            "manual_invalid",
            "manual_pending"
          ]
        },
        "feature": {
          "type": ["string", "null"],
          "description": "feature_id from feature.json that this page belongs to. null if no match."
        },
        "class_name": {"type": ["string", "null"]},
        "source_file": {
          "type": ["string", "null"],
          "description": "Path relative to source.root for the class implementing this page."
        },
        "identity": {
          "type": "object",
          "properties": {
            "top_component": {"type": "string"},
            "current_fragment": {"type": ["string", "null"]},
            "page_class": {"type": "string"},
            "extra": {"type": "object"}
          }
        },
        "screenshot": {"type": "string", "description": "path relative to ui/"},
        "screenshot_fullpage": {"type": "string", "description": "stitched full-page screenshot path relative to ui/, present for scrollable pages"},
        "raw": {"type": "string", "description": "platform-native dump path relative to ui/ (for example raw.xml, raw.json, or raw.plist)"},
        "duration_ms": {"type": ["integer", "null"]},
        "capture_method": {"type": "string", "enum": ["auto", "manual"]},
        "hierarchy_available": {"type": "boolean"},
        "manual_notes": {"type": "string"},
        "scroll": {
          "type": "object",
          "description": "Scrollable-page summary copied from hierarchy.json so consumers do not need to open every hierarchy.",
          "properties": {
            "scrolled": {"type": "boolean"},
            "viewport_height": {"type": ["integer", "null"], "minimum": 0},
            "page_total_height": {"type": ["integer", "null"], "minimum": 0},
            "scroll_steps": {"type": ["integer", "null"], "minimum": 0},
            "source": {"type": "string"}
          },
          "additionalProperties": true
        },
        "resources": {
          "type": "object",
          "description": "Source-side resource extraction summary.",
          "properties": {
            "dir": {"type": "string"},
            "policy": {"type": ["string", "object", "null"]},
            "stats": {"type": "object"}
          },
          "additionalProperties": true
        },
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        },
        "resources_error": {"type": "string"},
        "error": {"type": "string"},
        "html_error": {"type": "string"},
        "hierarchy_md_error": {"type": "string"},
        "overlay_svg_error": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
